# ---------------------------------------------------------------------------
# Bu dosyayı `.env.local` olarak kopyala ve değerleri Supabase panelinden
# (Project Settings > API) doldur. `.env.local` commit edilmez.
#
# Hiçbirini doldurmazsan site yine çalışır: giriş kapalı olur, ilerleme
# yalnızca tarayıcıda (localStorage) tutulur.
# ---------------------------------------------------------------------------

# Tarayıcıya açık değerler. Açık olmaları normaldir; güvenliği RLS sağlar.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Yalnızca sunucuda kullanılır. RLS'i tamamen atlar — üye açma/silme gibi
# yönetim işlemleri için gerekir.
# ASLA NEXT_PUBLIC_ ön ekiyle tanımlama ve istemci koduna taşıma.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# E-posta bağlantılarının (şifre sıfırlama, davet) döneceği adres.
# Yerelde http://localhost:3000, canlıda kendi alan adın.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Aşağıdakiler de opsiyoneldir — boş bırakılırsa ilgili özellik sessizce
# kapalı kalır (hata fırlatmaz), doldurulunca otomatik aktifleşir.
# ---------------------------------------------------------------------------

# Google AdSense yayıncı kimliği (ca-pub-... biçiminde). Boşsa reklam hiç
# render edilmez/yüklenmez — native (Capacitor) uygulamada zaten hiç
# yüklenmez, AdSense politikası mobil app içi reklamı yasaklar.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# İyzico (web'de premium abonelik ödemesi). Boşsa /premium sayfasındaki
# "abone ol" butonları "çok yakında" gösterip devre dışı kalır; 7 günlük
# kartsız deneme bundan bağımsız her zaman çalışır. Canlıya almadan önce
# src/lib/payments/iyzico.ts'teki istek/yanıt şeklini güncel İyzico
# dokümantasyonuyla teyit et — API erişimi olmadan yazıldı, doğrulanmadı.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Google reCAPTCHA v3 (kayıt formu, bot koruması). Boşsa doğrulama atlanır.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
